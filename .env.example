# Copy to .env and fill in.
CRUSTDATA_API_TOKEN=

# Optional: claim extraction and email wording use Claude. Without it,
# a rule-based extractor is used and everything else still works.
ANTHROPIC_API_KEY=
# SECONDLOOK_MODEL=claude-opus-5-5

# Optional: news analysis with an LLM. Providers are tried in NEWS_PROVIDERS order
# (default: bedrock if its key is set, else nvidia). Without any key, news is
# screened with a keyword scan.
# NEWS_PROVIDERS=mantle,bedrock,nvidia
AWS_BEARER_TOKEN_BEDROCK=
# Bedrock "Mantle" (OpenAI-compatible) endpoint: used first when set
# BEDROCK_MANTLE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# BEDROCK_MANTLE_MODEL=qwen.qwen3-vl-235b-a22b-instruct
# BEDROCK_MODEL=openai.gpt-6.1-sol
# BEDROCK_REGION=us-east-1
# BEDROCK_TIMEOUT=90
NVIDIA_API_KEY=
# NEWS_MODEL=moonshotai/kimi-k3.1-pro
# NEWS_MODEL_TIMEOUT=150

# Optional: to show rupee cost per dossier. Use your contracted credit price.
# CRUSTDATA_CREDIT_USD=
# USD_INR=

# Email delivery for the intro (step 3) and the request list (step 5).
# Nothing is ever sent without a named person's approval.
# Transport: resend if RESEND_API_KEY is set, else smtp if SMTP_HOST is set,
# else the demo mailbox in data/mailbox (nothing leaves the machine).
# MAIL_TRANSPORT=resend          # force one of: resend, smtp, file
MAIL_FROM=                       # e.g. "Acme Strategy <deals@acme.com>" (must be a sender your provider allows)
# MAIL_REPLY_TO=deals@acme.com
# MAIL_BCC=team@acme.com         # copy every approved send (comma-separated)

# Resend (recommended: provider-side Idempotency-Key, so a crash can't double-send).
# Verify your sending domain in Resend first.
RESEND_API_KEY=

# Or any SMTP server. Gmail: smtp.gmail.com, port 587, your address, an App Password.
# SMTP can't dedupe: an interrupted send is held as "uncertain" for a person to check.
SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls         # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=

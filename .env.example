# Copy to .env (or run: make setup-secrets). Never commit .env.
# ── Crustdata ─────────────────────────────────────────────
CRUSTDATA_API_KEY=cd_xxx
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_BASE_URL=https://api.crustdata.com

# ── Claude API (asked at first run: make setup-secrets) ──
# Prefixed with DD_ so the Claude Code session never picks it up as its own credential.
DD_ANTHROPIC_API_KEY=__ASK_USER__
CLAUDE_MODEL_CLASSIFY=auto
CLAUDE_MODEL_REASON=auto
CLAUDE_MODEL_ADVERSARIAL=auto
CLAUDE_MODEL_JUDGE=auto
LLM_MAX_RETRIES=4
LLM_TIMEOUT_S=90

# ── Gmail (asked at first run: make setup-secrets) ───────
# App password: Google Account → Security → 2-Step Verification → App passwords (16 letters).
GMAIL_ADDRESS=__ASK_USER__
GMAIL_APP_PASSWORD=__ASK_USER__
TEST_INBOX=__ASK_USER__
MAIL_PROVIDER=gmail
MAIL_MODE=test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_DAILY_CAP=50
MAILPIT_SMTP_PORT=1025
MAILPIT_API=http://localhost:8025

# ── Runtime ──────────────────────────────────────────────
DD_HTTP_MODE=replay
DD_ENV=dev
DD_TZ=Asia/Kolkata
DD_DB=data/datadesigner.sqlite
GIT_REMOTE_URL=

 "request_body": {
  "aggregations": [
   {
    "agg": "count",
    "field": "company.basic_info.company_id",
    "size": 50,
    "type": "group_by"
   }
  ],
  "filters": {
   "conditions": [
    {
     "field": "company.locations.country",
     "type": "=",
     "value": "IND"
    },
    {
     "field": "company.basic_info.industries",
     "type": "in",
     "value": [
      "Financial Services"
     ]
    },
    {
     "field": "metadata.date_added",
     "type": "=>",
     "value": "2026-10-01"
    },
    {
     "field": "job_details.category",
     "type": "=",
     "value": "Engineering"
    }
   ],
   "op": "and"
  },
  "limit": 0
 },
 "status": 200,
 "url": "https://api.crustdata.com/job/search"
